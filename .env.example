# Host directories that contain the Relaybook ledgers and the agent run files.
# Mounted read-only. Do not commit real paths.
LEDGER_DIR=
CONTEXT_DIR=

# Browser sign-in. Set both. The browser prompts and remembers them.
DASHBOARD_BASIC_USER=
DASHBOARD_BASIC_PASSWORD=

# Bearer token for scripts. Optional when basic auth is set.
DASHBOARD_TOKEN=

